/* ============================================================
 * Design Tokens - 轻食谱
 * 主色调：薄荷绿 + 米白，低饱和、健康治愈风
 * 所有页面通过 app.wxss 引入本文件
 * ============================================================ */
page {
  /* ---- 主色：薄荷绿系 ---- */
  --c-mint-50:  #F1FAF7;
  --c-mint-100: #DFF3EC;
  --c-mint-200: #BFE7DC;
  --c-mint-300: #96D6C6;
  --c-mint-400: #4FB6A0;
  --c-mint-500: #3FA18C;
  --c-mint-600: #2F8574;

  /* ---- 中性：米白 / 灰 ---- */
  --c-cream:    #FDFCF8;
  --c-bg:       #F7FBF9;
  --c-surface:  #FFFFFF;
  --c-line:     #EAF1EE;
  --c-ink:      #26312D;
  --c-ink-2:    #5A6862;
  --c-ink-3:    #9AA8A2;

  /* ---- 功能色（低饱和） ---- */
  --c-protein:  #6FB7E0;
  --c-carb:     #F0C36D;
  --c-fat:      #E8A08A;
  --c-danger:   #E58A8A;
  --c-warn:     #F2C878;

  /* ---- 圆角 ---- */
  --r-sm: 12rpx;
  --r-md: 20rpx;
  --r-lg: 28rpx;
  --r-xl: 40rpx;
  --r-pill: 999rpx;

  /* ---- 间距 ---- */
  --s-1: 8rpx;
  --s-2: 16rpx;
  --s-3: 24rpx;
  --s-4: 32rpx;
  --s-5: 48rpx;
  --s-6: 64rpx;

  /* ---- 阴影 ---- */
  --sh-1: 0 4rpx 16rpx rgba(63, 161, 140, 0.06);
  --sh-2: 0 8rpx 28rpx rgba(63, 161, 140, 0.10);
  --sh-3: 0 16rpx 44rpx rgba(38, 49, 45, 0.10);

  /* ---- 字号 ---- */
  --f-xs: 22rpx;
  --f-sm: 26rpx;
  --f-md: 30rpx;
  --f-lg: 36rpx;
  --f-xl: 44rpx;
  --f-2xl: 56rpx;

  /* ---- 动效 ---- */
  --ease: cubic-bezier(0.22, 1, 0.36, 1);
  --dur: 240ms;
}

.tabs {
  gap: var(--s-2);
  background: var(--c-surface);
  padding: 8rpx;
  border-radius: var(--r-lg);
  box-shadow: var(--sh-1);
}
.tabs__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--s-2) 0;
  border-radius: var(--r-md);
  transition: all var(--dur) var(--ease);
}
.tabs__emoji { font-size: 40rpx; }
.tabs__label { font-size: var(--f-xs); color: var(--c-ink-2); margin-top: 4rpx; }
.tabs__item--on {
  background: linear-gradient(160deg, var(--c-mint-50), var(--c-mint-100));
}
.tabs__item--on .tabs__label { color: var(--c-mint-600); font-weight: 600; }

.summary { background: linear-gradient(160deg, #FBFFFD, #EFF9F5); }
.summary__row { align-items: flex-end; }
.diff-row { justify-content: flex-start; }

.loading { padding: 100rpx 0; }
.loading__dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 6rpx solid var(--c-mint-100);
  border-top-color: var(--c-mint-400);
  animation: spin 800ms linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

.meal-block { margin-top: var(--s-4); }
.meal-head { margin-bottom: var(--s-2); padding: 0 var(--s-1); }
.meal-head__icon { font-size: 40rpx; margin-right: var(--s-2); }

.dish { padding: var(--s-3) var(--s-4); }
.dish__row { align-items: flex-start; }
.dish__thumb {
  width: 128rpx;
  height: 128rpx;
  border-radius: var(--r-md);
  flex: none;
  margin-right: var(--s-3);
  background: var(--c-mint-50);
}
.dish__main { min-width: 0; }
.dish__chev { color: var(--c-mint-400); font-size: var(--f-lg); flex: none; }
.dish__nut { border-top: 2rpx solid var(--c-line); padding-top: var(--s-2); }

.tag--soft { background: var(--c-bg); color: var(--c-ink-2); }

.bottom-actions {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  display: flex;
  gap: var(--s-3);
  padding: var(--s-3) var(--s-4) calc(var(--s-3) + env(safe-area-inset-bottom));
  background: rgba(253, 254, 253, 0.92);
  backdrop-filter: blur(10px);
  border-top: 2rpx solid var(--c-line);
}

.head { background: linear-gradient(160deg, #FBFFFD, #EFF9F5); }
.fav {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #fff;
  font-size: 36rpx;
  flex: none;
  box-shadow: var(--sh-1);
  transition: transform var(--dur) var(--ease);
}
.fav--on { transform: scale(1.06); }

/* 头图 */
.cover {
  position: relative;
  margin: calc(-1 * var(--s-4)) calc(-1 * var(--s-4)) var(--s-4);
  height: 480rpx;
  overflow: hidden;
}
.cover__img { width: 100%; height: 100%; display: block; }
.cover__grad {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 60%;
  background: linear-gradient(180deg, rgba(38,49,45,0), rgba(38,49,45,0.72));
}
.cover__title {
  position: absolute;
  left: var(--s-4);
  right: var(--s-4);
  bottom: var(--s-4);
}
.cover__name { color: #fff; text-shadow: 0 2rpx 12rpx rgba(0,0,0,0.25); }
.cover__chip {
  padding: 6rpx 18rpx;
  border-radius: var(--r-pill);
  font-size: var(--f-xs);
  color: #fff;
  background: rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(6px);
}
.cover__fav {
  position: absolute;
  right: var(--s-3);
  top: var(--s-3);
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  font-size: 36rpx;
  backdrop-filter: blur(8px);
  transition: transform var(--dur) var(--ease);
}
.cover__fav--on { transform: scale(1.06); }

.nut-top { align-items: center; }
.strip-line { width: 2rpx; height: 56rpx; background: var(--c-line); }

/* 食材 */
.ing-list { padding: var(--s-2) var(--s-4); }
.ing { padding: var(--s-3) 0; border-bottom: 2rpx solid var(--c-line); }
.ing:last-child { border-bottom: none; }
.ing__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--c-mint-300);
  margin-right: var(--s-3);
}
.ing__swap { color: var(--c-mint-400); font-size: var(--f-md); }
.ing:active { background: var(--c-mint-50); }

/* 步骤 */
.step { align-items: flex-start; padding: var(--s-2) 0; }
.step__no {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--c-mint-100);
  color: var(--c-mint-600);
  font-size: var(--f-xs);
  font-weight: 600;
  flex: none;
  margin-right: var(--s-3);
  margin-top: 4rpx;
}
.step__text { line-height: 1.7; }
.ml-2 { margin-left: var(--s-2); }

.bottom-actions {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: var(--s-3) var(--s-4) calc(var(--s-3) + env(safe-area-inset-bottom));
  background: rgba(253, 254, 253, 0.92);
  backdrop-filter: blur(10px);
  border-top: 2rpx solid var(--c-line);
}

/* 替换面板 */
.mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(38, 49, 45, 0.35);
  z-index: 100;
  animation: fadeIn var(--dur) var(--ease) both;
}
.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 101;
  background: var(--c-surface);
  border-radius: var(--r-xl) var(--r-xl) 0 0;
  padding: var(--s-3) var(--s-4) calc(var(--s-3) + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform var(--dur) var(--ease);
  max-height: 76vh;
  display: flex;
  flex-direction: column;
}
.sheet--open { transform: translateY(0); }
.sheet__handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: var(--r-pill);
  background: var(--c-line);
  margin: 0 auto var(--s-3);
}
.sheet__head { margin-bottom: var(--s-2); }
.sheet__origin {
  padding: var(--s-2) var(--s-3);
  background: var(--c-bg);
  border-radius: var(--r-md);
  margin-bottom: var(--s-2);
}
.sheet__list { max-height: 52vh; }
.sub-item {
  padding: var(--s-3);
  border-radius: var(--r-md);
  border: 2rpx solid var(--c-line);
  margin-bottom: var(--s-2);
  transition: all var(--dur) var(--ease);
}
.sub-item:active {
  border-color: var(--c-mint-300);
  background: var(--c-mint-50);
}
.sub-item--cur { opacity: 0.45; }
.sub-item__right { text-align: right; flex: none; }

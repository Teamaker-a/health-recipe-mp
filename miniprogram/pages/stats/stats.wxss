.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--s-3);
}
.stat { padding: var(--s-4) var(--s-2); }
.stat__num { line-height: 1.1; }

.rate-bar {
  height: 20rpx;
  border-radius: var(--r-pill);
  background: var(--c-line);
  overflow: hidden;
}
.rate-bar__fill {
  height: 100%;
  border-radius: var(--r-pill);
  background: linear-gradient(90deg, var(--c-mint-300), var(--c-mint-500));
  transition: width 500ms var(--ease);
}

.chart {
  align-items: flex-end;
  height: 300rpx;
  gap: 6rpx;
}
.bar { flex: 1; height: 100%; justify-content: flex-end; gap: 8rpx; }
.bar__track {
  width: 100%;
  flex: 1;
  display: flex;
  align-items: flex-end;
  background: var(--c-bg);
  border-radius: var(--r-sm);
  overflow: hidden;
}
.bar__fill {
  width: 100%;
  border-radius: var(--r-sm);
  background: linear-gradient(180deg, var(--c-mint-300), var(--c-mint-500));
  transition: height 500ms var(--ease);
  min-height: 4rpx;
}
.bar__label { font-size: 18rpx; }

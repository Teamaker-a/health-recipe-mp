<view class="rcard card card--tap" bindtap="onTap">
  <view class="rcard__cover">
    <image class="rcard__img" src="{{recipe.image}}" mode="aspectFill" lazy-load="{{true}}" />
    <view class="rcard__badge" wx:if="{{showMeal}}">{{recipe.mealLabel}}</view>
    <view class="rcard__kcal-badge">
      <text class="rcard__kcal-num">{{recipe.nutrition.kcal}}</text>
      <text class="rcard__kcal-unit">kcal</text>
    </view>
  </view>

  <view class="rcard__body">
    <text class="rcard__name t-md t-bold t-ellipsis">{{recipe.name}}</text>
    <view class="row wrap gap-1 mt-2">
      <text class="tag tag--soft">⏱ {{recipe.cookTime}}分钟</text>
      <text class="tag tag--soft">{{recipe.difficultyText}}</text>
    </view>
    <view class="rcard__macros row gap-2 mt-2">
      <text class="tag tag--protein">蛋白 {{recipe.nutrition.protein}}g</text>
      <text class="tag tag--carb">碳水 {{recipe.nutrition.carb}}g</text>
      <text class="tag tag--fat">脂肪 {{recipe.nutrition.fat}}g</text>
    </view>
  </view>
</view>

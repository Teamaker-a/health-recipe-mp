.macro__bar {
  display: flex;
  height: 20rpx;
  border-radius: var(--r-pill);
  overflow: hidden;
  background: var(--c-line);
  margin-top: 12rpx;
}
.macro__seg {
  height: 100%;
  transition: width 400ms var(--ease);
}
.macro__seg--p { background: var(--c-protein); }
.macro__seg--c { background: var(--c-carb); }
.macro__seg--f { background: var(--c-fat); }

.macro__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex: none;
}
.macro__dot--p { background: var(--c-protein); }
.macro__dot--c { background: var(--c-carb); }
.macro__dot--f { background: var(--c-fat); }

.macro__item { align-items: center; }
.macro--compact .macro__bar { height: 14rpx; }
